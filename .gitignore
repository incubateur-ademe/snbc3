data/input/travail/

# Données brutes téléchargées (volumineuses, reproductibles)
data/raw/
cache_dju/
output_dju/

# Fichiers intermédiaires et de sortie (reproductibles)
data/interim/
data/output/

# Formats de données lourds
*.parquet
*.csv.gz


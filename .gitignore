__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# État interne de doit (dodo.py)
.doit.*

# Virtual environments
.venv

# Classeur de travail SNBC3 (données DGEC brutes et détail du retraitement) :
